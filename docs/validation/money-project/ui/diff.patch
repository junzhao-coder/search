+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+bp = Blueprint("dash", __name__, url_prefix="/dash",
+               template_folder=str(ROOT / "templates"))
+
+from . import routes  # noqa: E402,F401
+
+__all__ = ["bp"]
