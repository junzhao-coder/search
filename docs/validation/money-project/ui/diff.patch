+<!doctype html>
+<html lang="zh-CN">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>{% block title %}机会情报 Dashboard{% endblock %}</title>
+  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
+  <style>
+    .dash-meta { display:flex; flex-wrap:wrap; gap:8px 20px; color:var(--muted); font-size:13px; margin:0 0 14px; }
+    .dash-meta code { font-size:12px; }
+    .notice { border:1px solid #d4a72c; background:#fff8c5; padding:8px 12px; border-radius:6px; margin:0 0 14px; font-size:13px; }
+    .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin:0 0 16px; }
+    .card { border:1px solid var(--line); border-radius:6px; padding:10px 12px; background:var(--panel); }
+    .card .n { font-size:22px; font-weight:700; display:block; }
+    .card .l { color:var(--muted); font-size:13px; }
+    .table-wrap { overflow:auto; max-height:70vh; }
+    table.data { border-collapse:collapse; width:100%; font-size:13px; }
+    table.data th, table.data td { border-bottom:1px solid var(--line); padding:6px 8px; text-align:left; vertical-align:top; }
+    table.data th { position:sticky; top:0; background:var(--panel); cursor:pointer; white-space:nowrap; }
+    table.data td.num { text-align:right; font-variant-numeric:tabular-nums; }
+    .badge { display:inline-block; border:1px solid var(--line); border-radius:10px; padding:0 7px; font-size:12px; }
+    .badge-ok { border-color:#1a7f37; color:#1a7f37; }
+    .badge-warn { border-color:#9a6700; color:#9a6700; }
+    .badge-err { border-color:#b42318; color:#b42318; }
+    .muted { color:var(--muted); }
+    .toolbar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:0 0 8px; }
+    .toolbar input { padding:4px 6px; border:1px solid var(--line); border-radius:4px; min-width:240px; }
+  </style>
+</head>
+<body data-page="dash-{{ active }}">
+  <a class="skip-link" href="#main">跳到主要内容</a>
+  <header class="topbar">
+    <p class="brand">机会情报 Dashboard <span class="muted">（只读）</span></p>
+    <nav class="nav" aria-label="Dashboard 导航">
+      {% for key, label, endpoint in nav %}
+      <a href="{{ url_for(endpoint) }}"{% if active == key %} aria-current="page"{% endif %}>{{ label }}</a>
+      {% endfor %}
+    </nav>
+  </header>
+  <main id="main" class="main">
+    <div class="dash-meta">
+      <span>数据来源：<code>docs/validation/money-project/{scoring,sourcing}</code> · <code>tools/platform-login/data</code> · <code>docs/validation/x-collect/topic-crawler</code></span>
+      <span>文件更新时间（UTC）：<strong>{{ generated_at }}</strong></span>
+      <span>只读视图；不查询/写入业务库，不触发采集或账号动作。</span>
+    </div>
+    {% if warnings %}
+    <div class="notice" role="alert">
+      <strong>数据提示：</strong>
+      <ul>{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
+    </div>
+    {% endif %}
+    {% block content %}{% endblock %}
+  </main>
+  <footer class="footer">
+    <p>只读 Dashboard：数据来自本机 CSV/JSONL 产物；缺失文件显示“暂无数据/文件缺失”，不补造数据。</p>
+  </footer>
+  <script>
+    (function () {
+      function cellValue(row, index) {
+        return (row.cells[index] ? row.cells[index].innerText : '').trim();
+      }
+      document.addEventListener('click', function (event) {
+        var th = event.target.closest('th[data-sort]');
+        if (!th) return;
+        var table = th.closest('table');
+        var body = table.tBodies[0];
+        if (!body) return;
+        var index = Array.prototype.indexOf.call(th.parentNode.cells, th);
+        var dir = th.getAttribute('data-dir') === 'asc' ? -1 : 1;
+        th.setAttribute('data-dir', dir === 1 ? 'desc' : 'asc');
+        var rows = Array.prototype.slice.call(body.rows);
+        rows.sort(function (a, b) {
+          var av = cellValue(a, index), bv = cellValue(b, index);
+          if (th.getAttribute('data-sort') === 'num') {
+            av = parseFloat(av.replace(/[^0-9.\-]/g, '')) || 0;
+            bv = parseFloat(bv.replace(/[^0-9.\-]/g, '')) || 0;
+          }
+          return (av > bv ? 1 : av < bv ? -1 : 0) * dir;
+        });
+        rows.forEach(function (row) { body.appendChild(row); });
+      });
+      document.addEventListener('input', function (event) {
+        var input = event.target.closest('input[data-filter]');
+        if (!input) return;
+        var table = document.querySelector(input.getAttribute('data-filter'));
+        if (!table || !table.tBodies[0]) return;
+        var q = input.value.toLowerCase();
+        Array.prototype.forEach.call(table.tBodies[0].rows, function (row) {
+          row.hidden = q && row.innerText.toLowerCase().indexOf(q) < 0;
+        });
+      });
+    })();
+  </script>
+</body>
+</html>
