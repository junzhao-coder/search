{"sha":"aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","node_id":"C_kwDOPa3YDtoAKGFhNmNjOWY2Zjg1M2Q2Y2JjMTdlNGRjOWI3OTQ2ZDQwNmNhYWJjNmY","commit":{"author":{"name":"Vibhek Soni","email":"102437829+vibheksoni@users.noreply.github.com","date":"2026-10-19T19:23:19Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-19T19:23:19Z"},"message":"Merge pull request #37 from bepcyc/fix/mcp-screenshot-content\n\nfix(screenshots): return typed MCP image content","tree":{"sha":"54c7fe83131c97f2fdc722f8ba617f17f52e4cbe","url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/git/trees/54c7fe83131c97f2fdc722f8ba617f17f52e4cbe"},"url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/git/commits/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq1m4nCRC1aQ7uu5UhlAAA4FcQABgvnsXI4RLI4tnFYcuUq/dW\n3oEDdhThUjJQrlDfCQfpRbnv1j3DI1OXsug5gYOJu3GpkVZxQdYP0JRhHxIzop3Z\nrDqzygIX4ioQkJ/TAN3K2t+Z6OyZ4wxhguSoMhuVfZSdFzDsATJK2zCzCvt6PG96\nUHBXpLjDricERPIXPqHj7m8HBfBrEWmvlzO6PaGiieWGELE5nBUXkdBLRwaYZ8ou\n+eWCfp1O3vYSCd8dF0Il2jNzs1tKK+IcQTEKvihv6XtqgMQhSC9zv0isbZxNmHTC\nwCEcTQfcuoPUwtC7CCGwKTil7MgEze53HVZlOf8G7V3nlkf+N6BoqADoheqPBTK3\nHW0K6tFS1hGtvivZsSYLWsQDMOpEeSTb0kMufUKFklIh4iX1cpAilTmdZJOqbNEM\ni9lCJuw/2V8Wpf8IfObuXaLkUR9X5d5YvrVPGiAi6iIFH+arTWHhoGJOCT9Gl4P3\nvNx6AN9kORQZ2ZKj8FKZEw/aBuSvwA8ox8AKjm8AuLXJJHQoaZjs8H46JB0TKxaP\nJKGjuOdwbYIwqjFJYReu9mvEjMEsl+Nm+UkJ74e81G+luB3QE2qw0FfcpmMTTo56\nT4i26yY9LUGe78qAuups6cuJuy1gMV1vrNGYp79WIdkeuMHx7bNjSmRmWgwwrdVU\nXrWM5s5aMTg1Y+DYtKTx\n=HQp7\n-----END PGP SIGNATURE-----\n","payload":"tree 54c7fe83131c97f2fdc722f8ba617f17f52e4cbe\nparent e02a44373769cf4064da8994fc2f6c18b3c58e80\nparent 5eb5ccca20138f30d686d12856a03e7aa3919e02\nauthor Vibhek Soni <102437829+vibheksoni@users.noreply.github.com> 1792437799 -0400\ncommitter GitHub <noreply@github.com> 1792437799 -0400\n\nMerge pull request #37 from bepcyc/fix/mcp-screenshot-content\n\nfix(screenshots): return typed MCP image content","verified_at":"2026-10-19T19:23:19Z"}},"url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/commits/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","html_url":"https://github.com/vibheksoni/stealth-browser-mcp/commit/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","comments_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/commits/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/comments","author":{"login":"vibheksoni","id":102437829,"node_id":"U_kgDOBhsTxQ","avatar_url":"https://avatars.githubusercontent.com/u/102437829?v=4","gravatar_id":"","url":"https://api.github.com/users/vibheksoni","html_url":"https://github.com/vibheksoni","followers_url":"https://api.github.com/users/vibheksoni/followers","following_url":"https://api.github.com/users/vibheksoni/following{/other_user}","gists_url":"https://api.github.com/users/vibheksoni/gists{/gist_id}","starred_url":"https://api.github.com/users/vibheksoni/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/vibheksoni/subscriptions","organizations_url":"https://api.github.com/users/vibheksoni/orgs","repos_url":"https://api.github.com/users/vibheksoni/repos","events_url":"https://api.github.com/users/vibheksoni/events{/privacy}","received_events_url":"https://api.github.com/users/vibheksoni/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"e02a44373769cf4064da8994fc2f6c18b3c58e80","url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/commits/e02a44373769cf4064da8994fc2f6c18b3c58e80","html_url":"https://github.com/vibheksoni/stealth-browser-mcp/commit/e02a44373769cf4064da8994fc2f6c18b3c58e80"},{"sha":"5eb5ccca20138f30d686d12856a03e7aa3919e02","url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/commits/5eb5ccca20138f30d686d12856a03e7aa3919e02","html_url":"https://github.com/vibheksoni/stealth-browser-mcp/commit/5eb5ccca20138f30d686d12856a03e7aa3919e02"}],"stats":{"total":509,"additions":450,"deletions":59},"files":[{"sha":"5281e29e617f94ded5f31d985abc21b719e15b11","filename":"CHANGELOG.md","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/vibheksoni/stealth-browser-mcp/blob/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/CHANGELOG.md","raw_url":"https://github.com/vibheksoni/stealth-browser-mcp/raw/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/CHANGELOG.md","contents_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/contents/CHANGELOG.md?ref=aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","patch":"@@ -11,6 +11,7 @@ The format is based on Keep a Changelog and adheres to Semantic Versioning where\n \n - **Stealth benchmark** - `python -m benchmarks.stealth` runs the browser against a bundled local probe, an init script capability check, Sannysoft, Intoli, CreepJS, Cloudflare (nowsecure.nl), and the tls.peet.ws TLS and HTTP/2 fingerprint API. Each target reports PASS, DEGRADED, FAIL, or UNREACHABLE with its individual checks, and each run writes a JSON result file. A weekly GitHub Actions workflow runs it on Linux, Windows, and macOS in headless and headed mode plus the previous Chrome release, commits results to `docs/stealth-results/`, regenerates the automated section of `STEALTH_TESTS.md`, and opens a `stealth-regression` issue when a target gets worse (#25).\n - **`STEALTH_BROWSER_EXECUTABLE`** - Environment variable that selects the browser executable instead of auto-detection.\n+- **Screenshot images** - `take_screenshot` returns MCP image content with metadata instead of base64 text, scales large captures down to fit client limits instead of writing a file on the server, and accepts `quality` (JPEG, 1 to 100) and `max_width` to shrink images. Thanks to @bepcyc (#37).\n - **Page bindings** - `create_page_binding`, `get_page_binding_calls`, `resolve_page_binding_call`, and `remove_page_binding` let page JavaScript call `window.<name>(...args)` and get a Promise that the agent answers. Calls are queued as JSON (64 KB per call, 500 queued per instance), `auto_resolve` answers immediately with a fixed value, and bindings follow every tab and navigation. Nothing runs on the server host. This replaces `create_python_binding`.\n - **`BROWSER_TAB_RECYCLE_NAVIGATIONS`** - Opt-in main tab recycling. It was always on at 25 navigations before.\n - **Launch flags benchmark target** - Fails when the real Chrome command line has automation, sandbox-disabling, or unsupported flags."},{"sha":"86b65b232b3f7cc1299bef520d5620d3f0b8af78","filename":"README.md","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/vibheksoni/stealth-browser-mcp/blob/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/README.md","raw_url":"https://github.com/vibheksoni/stealth-browser-mcp/raw/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/README.md","contents_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/contents/README.md?ref=aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","patch":"@@ -352,6 +352,8 @@ client = Client(\n | `get_page_content()` | Read page HTML and text |\n | `take_screenshot()` | Capture screenshots |\n \n+`take_screenshot` returns an MCP image with metadata (format, size, scale, quality, byte count, SHA-256), so remote clients can show it without reading the server's disk. Large captures, such as long full-page screenshots, are scaled down to fit client limits (8000 px per side, about 5 MB), and the metadata reports the original size. Pass `format=\"jpeg\"` with a lower `quality`, or `max_width`, for smaller images, or `file_path` to save the full-resolution image on the server.\n+\n </details>\n \n <details>"},{"sha":"ec5137b84e0e7fad42703a86679b8f03dd585724","filename":"src/screenshot_encoder.py","status":"added","additions":148,"deletions":0,"changes":148,"blob_url":"https://github.com/vibheksoni/stealth-browser-mcp/blob/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/src%2Fscreenshot_encoder.py","raw_url":"https://github.com/vibheksoni/stealth-browser-mcp/raw/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/src%2Fscreenshot_encoder.py","contents_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/contents/src%2Fscreenshot_encoder.py?ref=aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","patch":"@@ -0,0 +1,148 @@\n+\"\"\"Fit browser screenshots into MCP image limits.\"\"\"\n+\n+import hashlib\n+import io\n+from pathlib import Path\n+from typing import Any, Dict, Optional, Tuple\n+\n+from PIL import Image\n+\n+INLINE_MAX_BYTES = 3_750_000\n+MAX_IMAGE_SIDE = 8000\n+MAX_CAPTURE_BYTES = 64 * 1024 * 1024\n+MAX_DECODE_PIXELS = 100_000_000\n+DEFAULT_QUALITY = 85\n+FIT_ATTEMPTS = 6\n+\n+\n+def validate_options(format: str, quality: int, max_width: Optional[int]) -> str:\n+    \"\"\"\n+    Normalize the format and check screenshot options before capturing.\n+\n+    Args:\n+        format (str): png, jpeg, or jpg.\n+        quality (int): JPEG quality from 1 to 100.\n+        max_width (Optional[int]): Largest width to return, or None.\n+\n+    Returns:\n+        str: Normalized format, png or jpeg.\n+\n+    Raises:\n+        ValueError: When an option is out of range.\n+    \"\"\"\n+    normalized = (format or \"png\").lower()\n+    if normalized == \"jpg\":\n+        normalized = \"jpeg\"\n+    if normalized not in (\"png\", \"jpeg\"):\n+        raise ValueError(f\"Unsupported screenshot format: {format}. Use 'png' or 'jpeg'.\")\n+    if not isinstance(quality, int) or not 1 <= quality <= 100:\n+        raise ValueError(f\"quality must be an integer from 1 to 100, got {quality!r}\")\n+    if max_width is not None and (not isinstance(max_width, int) or max_width < 1):\n+        raise ValueError(f\"max_width must be a positive integer, got {max_width!r}\")\n+    return normalized\n+\n+\n+def _encode(image: Image.Image, format: str, quality: int) -> bytes:\n+    \"\"\"\n+    Encode an image.\n+\n+    Args:\n+        image (Image.Image): Image to encode.\n+        format (str): png or jpeg.\n+        quality (int): JPEG quality.\n+\n+    Returns:\n+        bytes: Encoded image.\n+    \"\"\"\n+    buffer = io.BytesIO()\n+    if format == \"jpeg\":\n+        image.save(buffer, format=\"JPEG\", quality=quality, optimize=True)\n+    else:\n+        image.save(buffer, format=\"PNG\", optimize=True)\n+    return buffer.getvalue()\n+\n+\n+def _flatten_for_jpeg(image: Image.Image) -> Image.Image:\n+    \"\"\"\n+    Composite transparency onto white, since JPEG has no alpha channel.\n+\n+    Args:\n+        image (Image.Image): Decoded capture.\n+\n+    Returns:\n+        Image.Image: RGB image.\n+    \"\"\"\n+    if image.mode == \"P\":\n+        image = image.convert(\"RGBA\")\n+    if image.mode in (\"RGBA\", \"LA\"):\n+        background = Image.new(\"RGB\", image.size, (255, 255, 255))\n+        background.paste(image, mask=image.split()[-1])\n+        return background\n+    return image.convert(\"RGB\") if image.mode != \"RGB\" else image\n+\n+\n+def fit_screenshot(\n+    capture_path: Path,\n+    format: str,\n+    quality: int = DEFAULT_QUALITY,\n+    max_width: Optional[int] = None,\n+) -> Tuple[bytes, Dict[str, Any]]:\n+    \"\"\"\n+    Encode a captured screenshot so it fits inline MCP image limits.\n+\n+    The image is scaled down, keeping its aspect ratio, when it is wider than\n+    max_width, longer than MAX_IMAGE_SIDE on either side, or larger than\n+    INLINE_MAX_BYTES once encoded. INLINE_MAX_BYTES keeps the base64 payload\n+    near 5 MB, which is what Claude and similar clients accept.\n+\n+    Args:\n+        capture_path (Path): File written by the browser capture.\n+        format (str): png or jpeg.\n+        quality (int): JPEG quality from 1 to 100, ignored for PNG.\n+        max_width (Optional[int]): Largest width to return, or None.\n+\n+    Returns:\n+        Tuple[bytes, Dict[str, Any]]: Encoded image and metadata with format,\n+        width, height, original_width, original_height, scale, quality, bytes,\n+        sha256, and complete.\n+\n+    Raises:\n+        ValueError: When the capture is too large to decode safely or cannot be\n+        reduced below the inline limit.\n+    \"\"\"\n+    if capture_path.stat().st_size > MAX_CAPTURE_BYTES:\n+        raise ValueError(\"Screenshot exceeds inline capture limit; use file_path for export.\")\n+    with Image.open(capture_path) as captured:\n+        original_width, original_height = captured.size\n+        if original_width * original_height > MAX_DECODE_PIXELS:\n+            raise ValueError(\"Screenshot dimensions exceed the decode limit; use file_path for export.\")\n+        decoded = captured.copy()\n+    image = _flatten_for_jpeg(decoded) if format == \"jpeg\" else decoded\n+\n+    scale = 1.0\n+    if max_width and max_width < original_width:\n+        scale = max_width / original_width\n+    scale = min(scale, MAX_IMAGE_SIDE / max(original_width, original_height))\n+\n+    for _ in range(FIT_ATTEMPTS):\n+        size = (max(1, round(original_width * scale)), max(1, round(original_height * scale)))\n+        resized = image if size == image.size else image.resize(size, Image.LANCZOS)\n+        data = _encode(resized, format, quality)\n+        if len(data) <= INLINE_MAX_BYTES:\n+            return data, {\n+                \"format\": format,\n+                \"width\": size[0],\n+                \"height\": size[1],\n+                \"original_width\": original_width,\n+                \"original_height\": original_height,\n+                \"scale\": round(size[0] / original_width, 4),\n+                \"quality\": quality if format == \"jpeg\" else None,\n+                \"bytes\": len(data),\n+                \"sha256\": hashlib.sha256(data).hexdigest(),\n+                \"complete\": True,\n+            }\n+        shrink = (INLINE_MAX_BYTES / len(data)) ** 0.5 * 0.95\n+        scale *= min(0.9, max(0.5, shrink))\n+    raise ValueError(\n+        \"Screenshot could not be reduced below the inline limit; lower quality, set max_width, or use file_path.\"\n+    )"},{"sha":"f0670e85666015786573082e03817f1eaca76c71","filename":"src/server.py","status":"modified","additions":33,"deletions":59,"changes":92,"blob_url":"https://github.com/vibheksoni/stealth-browser-mcp/blob/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/src%2Fserver.py","raw_url":"https://github.com/vibheksoni/stealth-browser-mcp/raw/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/src%2Fserver.py","contents_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/contents/src%2Fserver.py?ref=aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","patch":"@@ -10,12 +10,13 @@\n import tempfile\n from collections import defaultdict\n from contextlib import asynccontextmanager\n-from datetime import datetime\n from pathlib import Path\n from typing import Any, Dict, List, Optional, Union\n \n import nodriver as uc\n from fastmcp import FastMCP\n+from fastmcp.tools.tool import ToolResult\n+from mcp.types import ImageContent, TextContent\n from pydantic_core import to_json\n \n from browser_manager import BrowserManager\n@@ -37,6 +38,7 @@\n from persistent_storage import persistent_storage\n from progressive_element_cloner import progressive_element_cloner\n from response_handler import response_handler\n+from screenshot_encoder import DEFAULT_QUALITY, fit_screenshot, validate_options as validate_screenshot_options\n from stdio_guard import install_stdio_guard\n from platform_utils import validate_browser_environment, get_platform_info\n from process_cleanup import process_cleanup\n@@ -797,28 +799,32 @@ async def take_screenshot(\n     instance_id: str,\n     full_page: bool = False,\n     format: str = \"png\",\n-    file_path: Optional[str] = None\n-) -> Union[str, Dict[str, Any]]:\n+    file_path: Optional[str] = None,\n+    quality: int = DEFAULT_QUALITY,\n+    max_width: Optional[int] = None\n+) -> Union[str, ToolResult]:\n     \"\"\"\n     Take a screenshot of the page.\n \n+    The image is returned as MCP image content with metadata. It is scaled\n+    down, keeping its aspect ratio, when it is wider than max_width, longer\n+    than 8000 pixels on a side, or too large to send inline. The metadata\n+    reports the original size and the scale used.\n+\n     Args:\n         instance_id (str): Browser instance ID.\n         full_page (bool): Capture full page (not just viewport).\n-        format (str): Image format ('png' or 'jpeg').\n-        file_path (Optional[str]): Optional file path to save screenshot to.\n+        format (str): Image format ('png' or 'jpeg'). Use jpeg with a lower quality for smaller images.\n+        file_path (Optional[str]): Save the full-resolution screenshot to this path on the server instead.\n+        quality (int): JPEG quality from 1 to 100. PNG is lossless and ignores it.\n+        max_width (Optional[int]): Largest width in pixels to return, for a smaller image.\n \n     Returns:\n-        Union[str, Dict]: File path if file_path provided, otherwise optimized base64 data or file info dict.\n+        Union[str, ToolResult]: Server file location when file_path is given, otherwise\n+            an MCP image with format, width, height, original size, scale, quality,\n+            byte count, and SHA-256 metadata.\n     \"\"\"\n-    from PIL import Image\n-    import io\n-\n-    format = format.lower()\n-    if format == \"jpg\":\n-        format = \"jpeg\"\n-    if format not in (\"png\", \"jpeg\"):\n-        raise ValueError(f\"Unsupported screenshot format: {format}. Use 'png' or 'jpeg'.\")\n+    format = validate_screenshot_options(format, quality, max_width)\n \n     tab = await browser_manager.get_tab(instance_id)\n     if not tab:\n@@ -828,54 +834,22 @@ async def take_screenshot(\n         save_path = Path(file_path)\n         save_path.parent.mkdir(parents=True, exist_ok=True)\n         await tab.save_screenshot(save_path, format=format, full_page=full_page)\n-        return f\"Screenshot saved. AI agents should use the Read tool to view this image: {str(save_path.absolute())}\"\n-    \n+        return f\"Screenshot saved on the server: {str(save_path.absolute())}\"\n+\n     with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmp_file:\n         tmp_path = Path(tmp_file.name)\n-    \n+\n     try:\n-        await tab.save_screenshot(tmp_path, format=format, full_page=full_page)\n-        \n-        with Image.open(tmp_path) as img:\n-            if img.mode in ('RGBA', 'LA', 'P') and format.lower() == 'jpeg':\n-                background = Image.new('RGB', img.size, (255, 255, 255))\n-                if img.mode == 'P':\n-                    img = img.convert('RGBA')\n-                background.paste(img, mask=img.split()[-1] if img.mode in ('RGBA', 'LA') else None)\n-                img = background\n-            \n-            output_buffer = io.BytesIO()\n-            \n-            if format.lower() == 'jpeg':\n-                img.save(output_buffer, format='JPEG', quality=85, optimize=True)\n-            else:\n-                img.save(output_buffer, format='PNG', optimize=True)\n-            \n-            compressed_bytes = output_buffer.getvalue()\n-            \n-            base64_size = len(compressed_bytes) * 1.33\n-            estimated_tokens = int(base64_size / 4)\n-            \n-            if estimated_tokens > 20000:\n-                timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n-                screenshot_filename = f\"screenshot_{timestamp}_{instance_id[:8]}.{format.lower()}\"\n-                screenshot_path = response_handler.clone_dir / screenshot_filename\n-                \n-                with open(screenshot_path, 'wb') as f:\n-                    f.write(compressed_bytes)\n-                \n-                file_size_kb = len(compressed_bytes) / 1024\n-                return {\n-                    \"file_path\": str(screenshot_path),\n-                    \"filename\": screenshot_filename,\n-                    \"file_size_kb\": round(file_size_kb, 2),\n-                    \"estimated_tokens\": estimated_tokens,\n-                    \"reason\": \"Screenshot too large, automatically saved to file\",\n-                    \"message\": f\"Screenshot saved. AI agents should use the Read tool to view this image: {str(screenshot_path)}\"\n-                }\n-            \n-            return base64.b64encode(compressed_bytes).decode('utf-8')\n-            \n+        await tab.save_screenshot(tmp_path, format=\"png\", full_page=full_page)\n+        image_bytes, metadata = fit_screenshot(tmp_path, format, quality, max_width)\n+        return ToolResult(\n+            content=[ImageContent(\n+                type=\"image\",\n+                mimeType=f\"image/{format}\",\n+                data=base64.b64encode(image_bytes).decode(\"ascii\"),\n+            ), TextContent(type=\"text\", text=json.dumps(metadata))],\n+            structured_content=metadata,\n+        )\n     finally:\n         if tmp_path.exists():\n             os.unlink(tmp_path)"},{"sha":"cd450721b775a061b493b422745b034df775c1ca","filename":"tests/test_screenshot_content.py","status":"added","additions":266,"deletions":0,"changes":266,"blob_url":"https://github.com/vibheksoni/stealth-browser-mcp/blob/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/tests%2Ftest_screenshot_content.py","raw_url":"https://github.com/vibheksoni/stealth-browser-mcp/raw/aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f/tests%2Ftest_screenshot_content.py","contents_url":"https://api.github.com/repos/vibheksoni/stealth-browser-mcp/contents/tests%2Ftest_screenshot_content.py?ref=aa6cc9f6f853d6cbc17e4dc9b7946d406caabc6f","patch":"@@ -0,0 +1,266 @@\n+\"\"\"Screenshot wire-content tests without browser or cleanup side effects.\"\"\"\n+\n+import ast\n+import asyncio\n+import base64\n+import hashlib\n+import io\n+import json\n+import os\n+import sys\n+import struct\n+import tempfile\n+import unittest\n+import zlib\n+from pathlib import Path\n+from typing import Optional, Union\n+from unittest.mock import patch\n+\n+from fastmcp import Client, FastMCP\n+from fastmcp.client.transports import PythonStdioTransport\n+from fastmcp.tools.tool import ToolResult\n+from mcp.types import CallToolResult, ImageContent, TextContent\n+from PIL import Image\n+\n+ROOT = Path(__file__).resolve().parents[1]\n+sys.path.insert(0, str(ROOT / \"src\"))\n+\n+import screenshot_encoder\n+from screenshot_encoder import DEFAULT_QUALITY, fit_screenshot, validate_options\n+\n+\n+class ScreenshotContentTests(unittest.TestCase):\n+    def setUp(self):\n+        self.directory = tempfile.TemporaryDirectory()\n+        self.addCleanup(self.directory.cleanup)\n+        self.captures = []\n+        buffer = io.BytesIO()\n+        Image.new(\"RGBA\", (96, 64), (30, 60, 90, 128)).save(buffer, format=\"PNG\")\n+        self.png = buffer.getvalue()\n+        self.capture_error = None\n+        self.capture_started = None\n+\n+    def server(self):\n+        # Load the exact production function without importing server.py's global\n+        # cleanup/browser objects. Registration and client serialization are real.\n+        tree = ast.parse((ROOT / \"src/server.py\").read_text())\n+        function = next(n for n in tree.body if isinstance(n, ast.AsyncFunctionDef)\n+                        and n.name == \"take_screenshot\")\n+        mcp = FastMCP(\"screenshot-wire-test\")\n+        owner = self\n+\n+        class Tab:\n+            async def save_screenshot(self, path, **options):\n+                owner.captures.append((Path(path), options))\n+                Path(path).write_bytes(owner.png)\n+                if owner.capture_error:\n+                    raise owner.capture_error\n+                if owner.capture_started:\n+                    owner.capture_started.set()\n+                    await asyncio.Event().wait()\n+\n+        class Manager:\n+            async def get_tab(self, instance_id):\n+                return Tab() if instance_id == \"owned\" else None\n+\n+        namespace = dict(\n+            __name__=\"screenshot_test\", section_tool=lambda _: mcp.tool,\n+            browser_manager=Manager(), Path=Path, Optional=Optional, Union=Union,\n+            ToolResult=ToolResult, ImageContent=ImageContent, TextContent=TextContent,\n+            tempfile=tempfile, os=os, base64=base64, json=json, DEFAULT_QUALITY=DEFAULT_QUALITY,\n+            fit_screenshot=fit_screenshot, validate_screenshot_options=validate_options,\n+        )\n+        exec(compile(ast.Module(body=[function], type_ignores=[]), str(ROOT / \"src/server.py\"), \"exec\"), namespace)\n+        return mcp\n+\n+    def call(self, **kwargs):\n+        async def run():\n+            async with Client(self.server()) as client:\n+                result = await client.call_tool(\"take_screenshot\", {\"instance_id\": \"owned\", **kwargs}, raise_on_error=False)\n+                # Exercise the actual MCP CallToolResult JSON representation.\n+                wire = CallToolResult(content=result.content, structuredContent=result.structured_content,\n+                                      isError=result.is_error).model_dump_json()\n+                return CallToolResult.model_validate_json(wire)\n+        return asyncio.run(run())\n+\n+    def test_png_is_an_image_on_mcp_wire_with_complete_hash_metadata(self):\n+        result = self.call()\n+        self.assertFalse(result.isError)\n+        self.assertEqual(len(result.content), 2)\n+        image = result.content[0]\n+        self.assertIsInstance(image, ImageContent)\n+        self.assertEqual(image.mimeType, \"image/png\")\n+        data = base64.b64decode(image.data, validate=True)\n+        self.assertEqual(Image.open(io.BytesIO(data)).size, (96, 64))\n+        self.assertEqual(result.structuredContent[\"sha256\"], hashlib.sha256(data).hexdigest())\n+        self.assertEqual(result.structuredContent[\"bytes\"], len(data))\n+        self.assertTrue(result.structuredContent[\"complete\"])\n+        self.assertFalse(self.captures[0][0].exists())\n+        self.assertNotIn(\"file_path\", result.structuredContent)\n+        self.assertEqual(json.loads(result.content[1].text), result.structuredContent)\n+\n+    def test_jpg_alias_has_correct_mime_and_flattens_transparency(self):\n+        result = self.call(format=\"jpg\", full_page=True)\n+        self.assertFalse(result.isError)\n+        self.assertEqual(result.content[0].mimeType, \"image/jpeg\")\n+        image = Image.open(io.BytesIO(base64.b64decode(result.content[0].data)))\n+        self.assertEqual(image.format, \"JPEG\")\n+        self.assertEqual(image.mode, \"RGB\")\n+        self.assertTrue(all(abs(a - b) < 4 for a, b in zip(image.getpixel((30, 30)), (142, 157, 172))))\n+        self.assertTrue(self.captures[0][1][\"full_page\"])\n+\n+    def test_stdio_client_receives_image_without_server_file_access(self):\n+        async def run():\n+            transport = PythonStdioTransport(\n+                Path(__file__), args=[\"--serve-fixture\"],\n+                python_cmd=sys.executable, cwd=self.directory.name, keep_alive=False,\n+            )\n+            async with Client(transport) as client:\n+                self.assertIn(\"take_screenshot\", [tool.name for tool in await client.list_tools()])\n+                return await client.call_tool(\"take_screenshot\", {\"instance_id\": \"owned\"})\n+\n+        result = asyncio.run(run())\n+        self.assertEqual(len(result.content), 2)\n+        self.assertIsInstance(result.content[0], ImageContent)\n+        image = base64.b64decode(result.content[0].data, validate=True)\n+        self.assertEqual(Image.open(io.BytesIO(image)).size, (96, 64))\n+        self.assertEqual(result.structured_content[\"sha256\"], hashlib.sha256(image).hexdigest())\n+\n+    def test_near_limit_image_crosses_stdio_without_truncation(self):\n+        async def run():\n+            transport = PythonStdioTransport(\n+                Path(__file__), args=[\"--serve-large-fixture\"],\n+                python_cmd=sys.executable, cwd=self.directory.name, keep_alive=False,\n+            )\n+            async with Client(transport) as client:\n+                return await client.call_tool(\"take_screenshot\", {\"instance_id\": \"owned\"})\n+        result = asyncio.run(run())\n+        image = base64.b64decode(result.content[0].data, validate=True)\n+        self.assertGreater(len(image), screenshot_encoder.INLINE_MAX_BYTES * .9)\n+        self.assertLessEqual(len(image), screenshot_encoder.INLINE_MAX_BYTES)\n+        self.assertEqual(Image.open(io.BytesIO(image)).size, (1100, 1100))\n+        self.assertEqual(result.structured_content[\"scale\"], 1.0)\n+        self.assertEqual(result.structured_content[\"sha256\"], hashlib.sha256(image).hexdigest())\n+\n+    def test_explicit_file_export_stays_available(self):\n+        target = Path(self.directory.name) / \"exports\" / \"capture.png\"\n+        result = self.call(file_path=str(target))\n+        self.assertFalse(result.isError)\n+        self.assertTrue(target.is_file())\n+        self.assertIn(str(target), result.content[0].text)\n+        self.assertNotIn(\"Read tool\", result.content[0].text)\n+\n+    def test_invalid_format_fails_before_capture(self):\n+        self.assertTrue(self.call(format=\"gif\").isError)\n+        self.assertEqual(self.captures, [])\n+\n+    def test_oversized_capture_fails_and_removes_temporary_file(self):\n+        self.png = b\"x\" * 2048\n+        with patch.object(screenshot_encoder, \"MAX_CAPTURE_BYTES\", 1024):\n+            result = self.call()\n+        self.assertTrue(result.isError)\n+        self.assertIn(\"inline capture limit\", result.content[0].text)\n+        self.assertFalse(self.captures[0][0].exists())\n+\n+    def test_excessive_pixels_are_rejected_before_decode(self):\n+        header = self.png[12:16] + struct.pack(\">II\", 4097, 4097) + self.png[24:29]\n+        self.png = self.png[:12] + header + struct.pack(\">I\", zlib.crc32(header)) + self.png[33:]\n+        with patch.object(screenshot_encoder, \"MAX_DECODE_PIXELS\", 16 * 1024 * 1024):\n+            result = self.call()\n+        self.assertTrue(result.isError)\n+        self.assertIn(\"dimensions exceed the decode limit\", result.content[0].text)\n+        self.assertFalse(self.captures[0][0].exists())\n+\n+    def test_capture_failure_removes_temporary_file(self):\n+        self.capture_error = RuntimeError(\"Synthetic capture failure\")\n+        self.assertTrue(self.call().isError)\n+        self.assertFalse(self.captures[0][0].exists())\n+\n+    def test_cancelled_capture_removes_temporary_file(self):\n+        async def run():\n+            self.capture_started = asyncio.Event()\n+            async with Client(self.server()) as client:\n+                task = asyncio.create_task(client.call_tool(\"take_screenshot\", {\"instance_id\": \"owned\"}))\n+                await asyncio.wait_for(self.capture_started.wait(), 2)\n+                task.cancel()\n+                with self.assertRaises(asyncio.CancelledError):\n+                    await task\n+        asyncio.run(run())\n+        self.assertFalse(self.captures[0][0].exists())\n+\n+    def test_encoded_output_limit_is_not_silently_spilled_or_truncated(self):\n+        # A synthetic encoder result tests the precise post-compression boundary.\n+        # Input remains a valid small capture; only output encoding is mocked.\n+        self.png = ScreenshotContentTests.small_png()\n+        oversized = b\"x\" * (screenshot_encoder.INLINE_MAX_BYTES + 1)\n+        with patch.object(Image.Image, \"save\", lambda _, stream, **kw: stream.write(oversized)):\n+            result = self.call()\n+        self.assertTrue(result.isError)\n+        self.assertIn(\"could not be reduced\", result.content[0].text)\n+        self.assertFalse(self.captures[0][0].exists())\n+\n+    def test_tall_full_page_is_scaled_instead_of_failing(self):\n+        buffer = io.BytesIO()\n+        Image.new(\"RGB\", (400, 20000), (200, 10, 10)).save(buffer, format=\"PNG\")\n+        self.png = buffer.getvalue()\n+        result = self.call(full_page=True)\n+        self.assertFalse(result.isError)\n+        meta = result.structuredContent\n+        self.assertEqual((meta[\"width\"], meta[\"height\"]), (160, screenshot_encoder.MAX_IMAGE_SIDE))\n+        self.assertEqual((meta[\"original_width\"], meta[\"original_height\"]), (400, 20000))\n+        self.assertEqual(meta[\"scale\"], 0.4)\n+        image = Image.open(io.BytesIO(base64.b64decode(result.content[0].data)))\n+        self.assertEqual(image.size, (160, 8000))\n+\n+    def test_large_encoding_is_scaled_to_fit_byte_limit(self):\n+        buffer = io.BytesIO()\n+        Image.frombytes(\"RGB\", (600, 600), os.urandom(600 * 600 * 3)).save(buffer, format=\"PNG\")\n+        self.png = buffer.getvalue()\n+        with patch.object(screenshot_encoder, \"INLINE_MAX_BYTES\", 300_000):\n+            result = self.call()\n+        self.assertFalse(result.isError)\n+        self.assertLessEqual(result.structuredContent[\"bytes\"], 300_000)\n+        self.assertLess(result.structuredContent[\"scale\"], 1.0)\n+\n+    def test_max_width_and_quality(self):\n+        buffer = io.BytesIO()\n+        Image.frombytes(\"RGB\", (800, 400), os.urandom(800 * 400 * 3)).save(buffer, format=\"PNG\")\n+        self.png = buffer.getvalue()\n+        small = self.call(format=\"jpeg\", quality=20, max_width=200).structuredContent\n+        large = self.call(format=\"jpeg\", quality=95, max_width=200).structuredContent\n+        self.assertEqual((small[\"width\"], small[\"height\"], small[\"scale\"]), (200, 100, 0.25))\n+        self.assertEqual((small[\"quality\"], large[\"quality\"]), (20, 95))\n+        self.assertLess(small[\"bytes\"], large[\"bytes\"])\n+        self.assertIsNone(self.call(format=\"png\").structuredContent[\"quality\"])\n+        self.assertEqual(self.call(max_width=5000).structuredContent[\"scale\"], 1.0)\n+\n+    def test_capture_is_lossless_before_encoding(self):\n+        self.call(format=\"jpeg\")\n+        self.assertEqual(self.captures[0][1][\"format\"], \"png\")\n+\n+    def test_invalid_quality_or_width_fails_before_capture(self):\n+        for options in ({\"quality\": 0}, {\"quality\": 101}, {\"max_width\": 0}):\n+            self.assertTrue(self.call(**options).isError, options)\n+        self.assertEqual(self.captures, [])\n+\n+    @staticmethod\n+    def small_png():\n+        buffer = io.BytesIO()\n+        Image.new(\"RGB\", (1, 1)).save(buffer, format=\"PNG\")\n+        return buffer.getvalue()\n+\n+\n+if __name__ == \"__main__\":\n+    if sys.argv[1:] in ([\"--serve-fixture\"], [\"--serve-large-fixture\"]):\n+        fixture = ScreenshotContentTests()\n+        fixture.setUp()\n+        if sys.argv[1] == \"--serve-large-fixture\":\n+            buffer = io.BytesIO()\n+            Image.frombytes(\"RGB\", (1100, 1100), os.urandom(1100 * 1100 * 3)).save(buffer, format=\"PNG\")\n+            fixture.png = buffer.getvalue()\n+        try:\n+            fixture.server().run(show_banner=False)\n+        finally:\n+            fixture.doCleanups()\n+    else:\n+        unittest.main()"}]}